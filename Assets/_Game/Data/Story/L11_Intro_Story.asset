  Lines:
  - SpeakerName: Tina
    DialogueText: 'We have entered the Weeping Swamps [X: 110, Y: 40]. The air is
      thick with dark magic.'
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Shadow-Weaver Elder
    DialogueText: Please... help us! The holy crusaders are burning our swamp! They
      call us heretics!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Crusader Captain
    DialogueText: By the light of the Goddess, purge this tainted land! Burn the
      heretics to ash!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Lilith
    DialogueText: Ah, the self-righteous Church. They intrude on our territory. Sovereign,
      let us teach them true fear.
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 

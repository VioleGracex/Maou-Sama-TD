  Lines:
  - SpeakerName: Crusader Captain
    DialogueText: May the Goddess... forgive... my failure...
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Shadow-Weaver Elder
    DialogueText: You saved us from the cleansing fire. The legends were true...
      the Sovereign has returned to protect the forgotten races!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Lilith
    DialogueText: Indeed. And in return, your magic belongs to us now.
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Shadow-Weaver Elder
    DialogueText: We gladly pledge our lives. Our Swamp Mages will fight by your
      side.
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}

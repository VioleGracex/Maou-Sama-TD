  Lines:
  - SpeakerName: Crusader General
    DialogueText: Demon! You have butchered my men and halted the holy purification!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Lilith
    DialogueText: Your "purification" is nothing but mindless slaughter. How hypocritical
      of the Church.
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Crusader General
    DialogueText: Silence, fiend! By the divine mandate of the Saintess of Light,
      I shall smite you back to the abyss!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Drakmora Commander
    DialogueText: Prepare yourselves! He radiates immense power!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}

  m_Script: {fileID: 11500000, guid: 30a132a6de54d4145a7d433b58a593e4, type: 3}
  m_Name: L6_Intro_Story
  m_EditorClassIdentifier: Assembly-CSharp::MaouSamaTD.Story.StoryDataSO
  Lines:
  - SpeakerName: Drakmora Commander
    DialogueText: 'Sovereign, we have arrived at Fort Vanguard [X: 45, Y: 50]. The
      remaining Loyalist Generals have fortified this position since your slumber.'
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Loyalist General
    DialogueText: Halt! Who dares approach the Vanguard? The Drakmora Commander?
      And... no. It cannot be.
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Lilith
    DialogueText: How quickly mortals forget the aura of their true master. Kneel
      before the Sovereign.
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Loyalist General
    DialogueText: It's a trick! The Sovereign has been asleep for fifty years! You
      must prove your identity in a tactical mock battle. Show us the strategic genius
      of the true Maou!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}

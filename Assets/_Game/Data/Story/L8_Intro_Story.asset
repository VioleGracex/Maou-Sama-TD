  Lines:
  - SpeakerName: Tina
    DialogueText: 'Maou-Sama, look! At Highwind Peak [X: 70, Y: 85], the local Beastman
      Tribe is being attacked!'
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Guild Scout
    DialogueText: Kill the beasts! The Adventurer's Guild claims this mountain!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Beastman Chieftain
    DialogueText: Defend the village! We will not fall to human greed!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Lilith
    DialogueText: The Guild expands too far. Sovereign, if we save the tribe, they
      will owe us a blood debt. Let us slaughter the intruders.
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 0}
    Focus: 0
    BackgroundOverlay: 0
    EventID: 
    VoiceClip: {fileID: 0}

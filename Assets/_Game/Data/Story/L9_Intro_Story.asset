  Lines:
  - SpeakerName: Tina
    DialogueText: The keep gates... but someone stands at the center of the bridge.
      The blind Sword Saint himself!
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 21300000, guid: 727040039e044b14ebd3ae20b995c711, type: 3}
    Focus: 1
    BackgroundOverlay: 2
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Ignis
    DialogueText: The Sword Saint... I remember him from fifty years ago. His blade
      is silent but lethal.
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 21300000, guid: 727040039e044b14ebd3ae20b995c711, type: 3}
    Focus: 1
    BackgroundOverlay: 2
    EventID: 
    VoiceClip: {fileID: 0}
  - SpeakerName: Ignis
    DialogueText: My Lord, let me face his blade. I will not fail you.
    PortraitLeft: {fileID: 0}
    PortraitMiddle: {fileID: 0}
    PortraitRight: {fileID: 0}
    Background: {fileID: 21300000, guid: 727040039e044b14ebd3ae20b995c711, type: 3}

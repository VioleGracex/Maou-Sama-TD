  m_Script: {fileID: 11500000, guid: 75c476018da43bc45bbd42d53cd0b8c8, type: 3}
  m_Name: L2_04_LilithAwakening_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::MaouSamaTD.Tutorial.DialogueData
  Style: 0
  CharactersPerSecond: 30
  Lines:
  - SpeakerName: Lilith
    SpeakerPortrait: {fileID: 0}
    PortraitOnLeft: 0
    LeftPortrait: {fileID: 0}
    RightPortrait: {fileID: 0}
    CenterPortrait: {fileID: 0}
    Focus: 0
    Text: "Mmm... such a powerful, cold grip. Is that you, my delicious Sovereign? You've certainly taken your time."
    Background: 1
    BackgroundImage: {fileID: 0}
    EventID: 
  - SpeakerName: Tina
    SpeakerPortrait: {fileID: 0}
    PortraitOnLeft: 0
    LeftPortrait: {fileID: 0}
    RightPortrait: {fileID: 0}
    CenterPortrait: {fileID: 0}
    Focus: 0
    Text: "Control your tongue, creature. But wait... look at the central seal!"
    Background: 1
    BackgroundImage: {fileID: 0}
    EventID: 
  - SpeakerName: Lilith
    SpeakerPortrait: {fileID: 0}
    PortraitOnLeft: 0
    LeftPortrait: {fileID: 0}
    RightPortrait: {fileID: 0}
    CenterPortrait: {fileID: 0}
    Focus: 0
    Text: "Oh? The central seal is breaking! Ah, it seems unsealing us has also unsealed that nasty ancient thing... the Abyssal Shade is awake!"
    Background: 1
    BackgroundImage: {fileID: 0}
    EventID: 
  - SpeakerName: Tina
    SpeakerPortrait: {fileID: 0}
    PortraitOnLeft: 0
    LeftPortrait: {fileID: 0}
    RightPortrait: {fileID: 0}
    CenterPortrait: {fileID: 0}
    Focus: 0
    Text: "Oh no! The unsealing has released the abyssal shadow! The exit to the tomb has shifted far deeper into the depths! The shadows are trying to escape!"
    Background: 1
    BackgroundImage: {fileID: 0}
    EventID: 
  - SpeakerName: Lilith
    SpeakerPortrait: {fileID: 0}
    PortraitOnLeft: 0
    LeftPortrait: {fileID: 0}
    RightPortrait: {fileID: 0}
    CenterPortrait: {fileID: 0}
    Focus: 0
    Text: "Fufu, well, let's not let them run away. Sovereign, place me on the high path to cut off their escape!"
    Background: 1
    BackgroundImage: {fileID: 0}
    EventID: 